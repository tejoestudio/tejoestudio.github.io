<!DOCTYPE html>
<html lang="{{lang}}" class="tejo-deck-html">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{vem_exu_pitch_deck.title}}</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="{{base_path}}css/tejo-base.css">
  <link rel="stylesheet" href="{{base_path}}css/tejo-brands.css">
</head>
<body>

<main class="tejo-deck">
  <!-- Slide 1: Cover -->
  <article class="tejo-slide" id="cover">
    <div class="tejo-slide-content">
      <figure class="tejo-slide-hero" style="border: none; box-shadow: none; background: transparent;">
        <img src="{{base_path}}press-kit/vem-exu/01_media/keyart/key_art.png" alt="{{presskit.alt_keyart_official}}" style="max-height: 55vh; object-fit: contain;">
      </figure>
      <img src="{{base_path}}press-kit/vem-exu/02_branding/logos/vem_exu_logo_black.png" alt="Vem, Exu Logo" style="max-height: 100px; margin: 0 auto 1rem auto; display: block;">
      <h2 style="margin-bottom: 0.5rem;">Tejo Estúdio</h2>
      <p style="font-weight: bold; color: var(--text-muted);">{{vem_exu_pitch_deck.slide_cover.month}}</p>
    </div>
  </article>

  <!-- Slide 2: Pitch -->
  <article class="tejo-slide" id="pitch">
    <div class="tejo-slide-content" style="max-width: 1200px;">
      <div style="display: flex; align-items: center; justify-content: center; gap: 4rem; text-align: left;">
        <div style="flex: 1;">
          <h2 style="font-size: 3.5rem; line-height: 1.1;">{{vem_exu_pitch_deck.slide_pitch.pitch_1}}</h2>
          <p style="font-size: 1.75rem; margin-top: 2rem;">{{{vem_exu_pitch_deck.slide_pitch.pitch_2}}}</p>
        </div>
        <div style="flex: 0 0 350px;">
          <img src="{{base_path}}press-kit/vem-exu/03_community/stickers/vem_exu_sticker_color_05.png" alt="Exu Kite" style="width: 100%; height: auto;">
        </div>
      </div>
    </div>
    <div class="tejo-deck-footer">02 — Vem, Exu</div>
  </article>

  <!-- Slide 3: The Game -->
  <article class="tejo-slide" id="the-game">
    <div class="tejo-slide-content" style="max-width: 1400px;">
      <h2 style="margin-bottom: 3rem;">{{vem_exu_pitch_deck.slide_game.title}}</h2>
      
      <div style="display: flex; gap: 2rem; margin-bottom: 3rem;">
        <figure style="flex: 1; margin: 0;">
          <img src="{{base_path}}press-kit/vem-exu/01_media/screenshots/vem_exu_screenshot_01.png" alt="{{presskit.alt_screenshot_01}}" style="width: 100%; height: 35vh; object-fit: cover;">
        </figure>
        <figure style="flex: 1; margin: 0;">
          <img src="{{base_path}}press-kit/vem-exu/01_media/screenshots/vem_exu_screenshot_09.png" alt="{{presskit.alt_screenshot_09}}" style="width: 100%; height: 35vh; object-fit: cover;">
        </figure>
      </div>

      <div style="display:flex; justify-content:center; gap: 3rem; flex-wrap: wrap; font-size: 1.75rem;">
        <strong>{{vem_exu_pitch_deck.slide_game.p1}}</strong>
        <strong>{{vem_exu_pitch_deck.slide_game.p2}}</strong>
        <strong>{{vem_exu_pitch_deck.slide_game.p3}}</strong>
        <strong>{{vem_exu_pitch_deck.slide_game.p4}}</strong>
        <strong>{{vem_exu_pitch_deck.slide_game.p5}}</strong>
      </div>
    </div>
    <div class="tejo-deck-footer">03 — Vem, Exu</div>
  </article>

  <!-- Slide 4: Story -->
  <article class="tejo-slide" id="story">
    <div class="tejo-slide-content" style="max-width: 1400px;">
      <h2 style="margin-bottom: 3rem;">{{vem_exu_pitch_deck.slide_story.title}}</h2>
      
      <div style="display: flex; gap: 4rem; text-align: left; align-items: center;">
        <div style="flex: 1;">
          <figure style="margin-bottom: 2rem;">
            <img src="{{base_path}}press-kit/vem-exu/01_media/screenshots/vem_exu_screenshot_10.png" alt="Comic panels fighting" style="width: 100%; height: auto;">
          </figure>
          <figure style="margin: 0;">
            <img src="{{base_path}}press-kit/vem-exu/01_media/screenshots/vem_exu_screenshot_05.png" alt="Exu sleeping" style="width: 100%; height: auto;">
          </figure>
        </div>
        <div style="flex: 1;">
          <p style="font-size: 2rem; margin-bottom: 2rem; max-width: 100%;">{{vem_exu_pitch_deck.slide_story.p1}}</p>
          <p style="font-size: 2rem; margin-bottom: 2rem; max-width: 100%;">{{vem_exu_pitch_deck.slide_story.p2}}</p>
          <p style="font-size: 2rem; max-width: 100%; color: var(--accent-color);"><strong>{{vem_exu_pitch_deck.slide_story.p3}}</strong></p>
        </div>
      </div>
    </div>
    <div class="tejo-deck-footer">04 — Vem, Exu</div>
  </article>

  <!-- Slide 5: Gameplay -->
  <article class="tejo-slide" id="gameplay">
    <div class="tejo-slide-content" style="max-width: 1400px;">
      <h2 style="margin-bottom: 2rem;">{{vem_exu_pitch_deck.slide_gameplay.title}}</h2>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; gap: 2rem; margin-bottom: 3rem;">
        <figure style="margin: 0; grid-row: span 2;">
          <img src="{{base_path}}press-kit/vem-exu/01_media/screenshots/vem_exu_screenshot_08.png" alt="Exploration" style="width: 100%; height: 100%; object-fit: cover; min-height: 40vh;">
        </figure>
        <figure style="margin: 0;">
          <img src="{{base_path}}press-kit/vem-exu/01_media/screenshots/vem_exu_screenshot_02.png" alt="Bubbles" style="width: 100%; height: 25vh; object-fit: cover;">
        </figure>
        <figure style="margin: 0;">
          <img src="{{base_path}}press-kit/vem-exu/01_media/screenshots/vem_exu_screenshot_03.png" alt="Stars" style="width: 100%; height: 25vh; object-fit: cover;">
        </figure>
      </div>

      <div style="display:flex; justify-content:center; gap: 3rem; flex-wrap: wrap; font-size: 1.75rem;">
        <strong>{{vem_exu_pitch_deck.slide_gameplay.p1}}</strong>
        <strong>{{vem_exu_pitch_deck.slide_gameplay.p2}}</strong>
        <strong>{{vem_exu_pitch_deck.slide_gameplay.p3}}</strong>
        <strong>{{vem_exu_pitch_deck.slide_gameplay.p4}}</strong>
        <strong>{{vem_exu_pitch_deck.slide_gameplay.p5}}</strong>
      </div>
    </div>
    <div class="tejo-deck-footer">05 — Vem, Exu</div>
  </article>

  <!-- Slide 6: What Makes It Different -->
  <article class="tejo-slide" id="different">
    <div class="tejo-slide-content" style="max-width: 1200px;">
      <h2 style="margin-bottom: 3rem;">{{vem_exu_pitch_deck.slide_difference.title}}</h2>
      
      <div style="display: flex; gap: 4rem; text-align: left; align-items: center;">
        <div style="flex: 1;">
          <ul style="font-size: 2rem; list-style: square; padding-left: 2rem; display: flex; flex-direction: column; gap: 1.5rem;">
            <li>{{vem_exu_pitch_deck.slide_difference.p1}}</li>
            <li>{{vem_exu_pitch_deck.slide_difference.p2}}</li>
            <li>{{vem_exu_pitch_deck.slide_difference.p3}}</li>
            <li>{{vem_exu_pitch_deck.slide_difference.p4}}</li>
            <li>{{vem_exu_pitch_deck.slide_difference.p5}}</li>
          </ul>
        </div>
        <div style="flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
          <img src="{{base_path}}press-kit/vem-exu/03_community/stickers/vem_exu_sticker_color_01.png" style="width:100%; height:auto; object-fit: contain;">
          <img src="{{base_path}}press-kit/vem-exu/03_community/stickers/vem_exu_sticker_color_18.png" style="width:100%; height:auto; object-fit: contain;">
          <img src="{{base_path}}press-kit/vem-exu/03_community/stickers/vem_exu_sticker_color_04.png" style="width:100%; height:auto; object-fit: contain;">
          <img src="{{base_path}}press-kit/vem-exu/03_community/stickers/vem_exu_sticker_color_14.png" style="width:100%; height:auto; object-fit: contain;">
        </div>
      </div>
    </div>
    <div class="tejo-deck-footer">06 — Vem, Exu</div>
  </article>

  <!-- Slide 7: Art Direction -->
  <article class="tejo-slide" id="art">
    <div class="tejo-slide-content" style="max-width: 1400px; position: relative;">
      
      <h2 style="position: absolute; top: -50px; left: 0; font-size: 5rem; z-index: 10; text-transform: uppercase; color: var(--accent-color); text-shadow: var(--shadow-hard); letter-spacing: -0.05em;">
        {{vem_exu_pitch_deck.slide_art.title}}
      </h2>

      <!-- 3 Columns of Characters with transparent backgrounds -->
      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; margin-top: 4rem; margin-bottom: 2rem;">
        <figure style="margin: 0; background: transparent; border: none; box-shadow: none; padding: 1rem;">
          <img src="{{base_path}}press-kit/vem-exu/02_branding/characters/vem_exu_character_full_02.png" alt="Taio" style="height: 50vh; width: 100%; object-fit: contain; filter: drop-shadow(0px 10px 10px rgba(0,0,0,0.1));">
        </figure>
        <figure style="margin: 0; background: transparent; border: none; box-shadow: none; padding: 1rem; transform: translateY(-20px);">
          <img src="{{base_path}}press-kit/vem-exu/02_branding/characters/vem_exu_character_full_01.png" alt="Exu" style="height: 55vh; width: 100%; object-fit: contain; filter: drop-shadow(var(--shadow-hard));">
        </figure>
        <figure style="margin: 0; background: transparent; border: none; box-shadow: none; padding: 1rem;">
          <img src="{{base_path}}press-kit/vem-exu/02_branding/characters/vem_exu_character_full_03.png" alt="Mother" style="height: 50vh; width: 100%; object-fit: contain; filter: drop-shadow(0px 10px 10px rgba(0,0,0,0.1));">
        </figure>
      </div>

      <div style="display:flex; justify-content:center; gap: 4rem; flex-wrap: wrap; font-size: 2rem; background: var(--bg-color); padding: 1rem;">
        <strong>{{vem_exu_pitch_deck.slide_art.p1}}</strong>
        <strong style="color: #d00;">{{vem_exu_pitch_deck.slide_art.p2}}</strong>
        <strong>{{vem_exu_pitch_deck.slide_art.p3}}</strong>
      </div>
    </div>
    <div class="tejo-deck-footer">07 — Vem, Exu</div>
  </article>

  <!-- Slide 8: Audio -->
  <article class="tejo-slide" id="audio">
    <div class="tejo-slide-content" style="max-width: 1400px;">
      <div style="display: flex; gap: 4rem; text-align: left; align-items: center; margin-bottom: 3rem;">
        <div style="flex: 0 0 300px;">
          <h2 style="font-size: 4.5rem; line-height: 1; margin-bottom: 2rem; text-transform: uppercase;">{{vem_exu_pitch_deck.slide_audio.title}}</h2>
          <img src="{{base_path}}press-kit/vem-exu/03_community/stickers/vem_exu_sticker_color_11.png" alt="Exu Sleeping" style="width: 100%; filter: drop-shadow(var(--shadow-hard)); transform: rotate(-5deg);">
        </div>
        <div style="flex: 1;">
          <figure style="margin: 0;">
            <img src="{{base_path}}press-kit/vem-exu/01_media/screenshots/vem_exu_screenshot_02.png" alt="Music Notes" style="width: 100%; height: 50vh; object-fit: cover;">
          </figure>
        </div>
      </div>
      <div style="display:flex; justify-content: flex-end; gap: 3rem; flex-wrap: wrap; font-size: 2rem;">
        <strong>{{vem_exu_pitch_deck.slide_audio.p1}}</strong>
        <strong>{{vem_exu_pitch_deck.slide_audio.p2}}</strong>
        <strong>{{vem_exu_pitch_deck.slide_audio.p3}}</strong>
      </div>
    </div>
    <div class="tejo-deck-footer">08 — Vem, Exu</div>
  </article>

  <!-- Slide 9: Team -->
  <article class="tejo-slide" id="team" style="position: relative; overflow: hidden;">
    <img src="{{base_path}}press-kit/vem-exu/02_branding/logos/tejo_logo_black.png" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 120%; opacity: 0.03; z-index: 0; pointer-events: none;">
    
    <div class="tejo-slide-content" style="max-width: 1400px; z-index: 1;">
      <h2 style="font-size: 4.5rem; text-transform: uppercase; margin-bottom: 4rem;">{{vem_exu_pitch_deck.slide_team.title}}</h2>
      
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem; text-align: left;">
        
        <div style="display: flex; gap: 1.5rem; align-items: center;">
          <img src="{{base_path}}images/michael_feitosa.png" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; filter: grayscale(100%); border: 2px solid #000;">
          <div>
            <strong style="display: block; font-size: 2rem; line-height: 1;">Michael Feitosa</strong>
            <span class="tejo-credits-text" style="font-size: 1.25rem;">{{vem_exu_pitch_deck.slide_team.t1_role}}</span>
          </div>
        </div>

        <div style="display: flex; gap: 1.5rem; align-items: center;">
          <img src="{{base_path}}press-kit/vem-exu/03_community/stickers/vem_exu_sticker_color_04.png" style="width: 80px; height: 80px; object-fit: contain;">
          <div>
            <strong style="display: block; font-size: 2rem; line-height: 1;">Rafael Semino</strong>
            <span class="tejo-credits-text" style="font-size: 1.25rem;">{{vem_exu_pitch_deck.slide_team.t2_role}}</span>
          </div>
        </div>

        <div style="display: flex; gap: 1.5rem; align-items: center;">
          <img src="{{base_path}}press-kit/vem-exu/03_community/stickers/vem_exu_sticker_color_06.png" style="width: 80px; height: 80px; object-fit: contain;">
          <div>
            <strong style="display: block; font-size: 2rem; line-height: 1;">Valdir Marte</strong>
            <span class="tejo-credits-text" style="font-size: 1.25rem;">{{vem_exu_pitch_deck.slide_team.t3_role}}</span>
          </div>
        </div>

        <div style="display: flex; gap: 1.5rem; align-items: center;">
          <img src="{{base_path}}press-kit/vem-exu/03_community/stickers/vem_exu_sticker_color_07.png" style="width: 80px; height: 80px; object-fit: contain;">
          <div>
            <strong style="display: block; font-size: 2rem; line-height: 1;">Zéis</strong>
            <span class="tejo-credits-text" style="font-size: 1.25rem;">{{vem_exu_pitch_deck.slide_team.t4_role}}</span>
          </div>
        </div>

        <div style="display: flex; gap: 1.5rem; align-items: center;">
          <img src="{{base_path}}press-kit/vem-exu/03_community/stickers/vem_exu_sticker_color_14.png" style="width: 80px; height: 80px; object-fit: contain;">
          <div>
            <strong style="display: block; font-size: 2rem; line-height: 1;">Douglas Levi</strong>
            <span class="tejo-credits-text" style="font-size: 1.25rem;">{{vem_exu_pitch_deck.slide_team.t5_role}}</span>
          </div>
        </div>

      </div>
    </div>
    <div class="tejo-deck-footer">09 — Vem, Exu</div>
  </article>

  <!-- Slide 10: Current Status -->
  <article class="tejo-slide" id="status">
    <div class="tejo-slide-content" style="max-width: 1400px; text-align: left;">
      <h2 style="font-size: 4.5rem; text-transform: uppercase; margin-bottom: 4rem;">{{vem_exu_pitch_deck.slide_status.title}}</h2>
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
        <div style="border: 4px solid var(--border-color); padding: 3rem; background: var(--bg-color); box-shadow: var(--shadow-hard-lg);">
          <div style="font-size: 3rem; font-weight: 900; line-height: 1.2;">{{vem_exu_pitch_deck.slide_status.p1}}</div>
        </div>
        <div style="border: 4px solid var(--border-color); padding: 3rem; background: var(--bg-color); box-shadow: var(--shadow-hard-lg);">
          <div style="font-size: 3rem; font-weight: 900; line-height: 1.2;">{{vem_exu_pitch_deck.slide_status.p2}}</div>
        </div>
        <div style="border: 4px solid var(--border-color); padding: 3rem; background: var(--bg-color); box-shadow: var(--shadow-hard-lg);">
          <div style="font-size: 3rem; font-weight: 900; line-height: 1.2;">{{vem_exu_pitch_deck.slide_status.p3}}</div>
        </div>
        <div style="border: 4px solid var(--border-color); padding: 3rem; background: #000; color: #fff; box-shadow: var(--shadow-hard-lg);">
          <div style="font-size: 4rem; font-weight: 900; line-height: 1; color: #f55;">{{vem_exu_pitch_deck.slide_status.p4}}</div>
        </div>
      </div>
    </div>
    <div class="tejo-deck-footer">10 — Vem, Exu</div>
  </article>

  <!-- Slide 11: Market -->
  <article class="tejo-slide" id="market">
    <div class="tejo-slide-content" style="max-width: 1400px;">
      <h2 style="font-size: 4.5rem; text-transform: uppercase; margin-bottom: 4rem; text-align: left;">{{vem_exu_pitch_deck.slide_market.title}}</h2>
      
      <div style="display: flex; gap: 6rem; text-align: left;">
        
        <div style="flex: 1; border-right: 4px solid var(--border-color); padding-right: 4rem;">
          <h3 style="font-size: 1.5rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 2rem;">Comparable Games</h3>
          <div style="font-size: 4rem; font-weight: 900; line-height: 1.3; text-transform: uppercase;">
            {{vem_exu_pitch_deck.slide_market.players}}
          </div>
        </div>

        <div style="flex: 1;">
          <h3 style="font-size: 1.5rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 2rem;">{{vem_exu_pitch_deck.slide_market.target}}</h3>
          <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div style="background: black; color: white; padding: 1.5rem 2rem; font-size: 2rem; font-weight: bold; display: inline-block; width: max-content;">{{vem_exu_pitch_deck.slide_market.target1}}</div>
            <div style="background: black; color: white; padding: 1.5rem 2rem; font-size: 2rem; font-weight: bold; display: inline-block; width: max-content;">{{vem_exu_pitch_deck.slide_market.target2}}</div>
            <div style="background: black; color: white; padding: 1.5rem 2rem; font-size: 2rem; font-weight: bold; display: inline-block; width: max-content;">{{vem_exu_pitch_deck.slide_market.target3}}</div>
            <div style="background: black; color: white; padding: 1.5rem 2rem; font-size: 2rem; font-weight: bold; display: inline-block; width: max-content;">{{vem_exu_pitch_deck.slide_market.target4}}</div>
          </div>
        </div>

      </div>
    </div>
    <div class="tejo-deck-footer">11 — Vem, Exu</div>
  </article>

  <!-- Slide 12: Contact -->
  <article class="tejo-slide" id="contact">
    <div class="tejo-slide-content">
      
      <img src="{{base_path}}press-kit/vem-exu/02_branding/logos/vem_exu_logo_black.png" alt="Vem, Exu Logo" style="max-height: 120px; margin: 0 auto 4rem auto; display: block;">
      
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; max-width: 800px; margin: 0 auto 4rem auto;">
        <a class="tejo-link-btn tejo-brand-steam" href="https://store.steampowered.com/app/4605020/Vem_Exu/" target="_blank" rel="noopener" style="font-size: 1.75rem; padding: 1.5rem;">Play Demo on Steam</a>
        <a class="tejo-link-btn tejo-brand-globe" href="{{site_url}}{{base_path}}press-kit/vem-exu" target="_blank" rel="noopener" style="font-size: 1.75rem; padding: 1.5rem;">View Press Kit</a>
        <a class="tejo-link-btn tejo-brand-email" href="mailto:{{index.email_address}}" target="_blank" rel="noopener" style="font-size: 1.75rem; padding: 1.5rem;">{{index.email_address}}</a>
        <a class="tejo-link-btn tejo-brand-instagram" href="{{index.url_instagram}}" target="_blank" rel="noopener" style="font-size: 1.75rem; padding: 1.5rem;">@tejoestudio</a>
      </div>

      <h2 style="font-size: 2rem; color: var(--text-muted); text-transform: uppercase; margin-bottom: 1rem;">Tejo Estúdio</h2>
    </div>
    <div class="tejo-deck-footer">12 — Vem, Exu</div>
  </article>

</main>

<!-- Language Switcher in presentation -->
<div class="tejo-lang-switcher-container" style="position: fixed; top: 1rem; right: 1rem; z-index: 1000;">
  {{#each other_langs}}
    <a href="{{link}}" class="tejo-lang-switcher" aria-label="{{aria}}" hreflang="{{code}}">{{label}}</a>
  {{/each}}
</div>

</body>
</html>

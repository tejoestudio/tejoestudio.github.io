<!DOCTYPE html>
<html lang="{{lang}}">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{portfolio_estudio.title}}</title>
  <link rel="icon" type="image/png" href="{{{base_path}}}images/tejo_icon.png">
  <meta name="description" content="{{portfolio_estudio.meta_description}}">
  <meta name="author" content="Tejo Estúdio">
  <link rel="canonical" href="{{site_url}}{{canonical_path}}">
  <link rel="alternate" hreflang="x-default" href="{{site_url}}{{canonical_base_path}}">
  <link rel="alternate" hreflang="{{lang}}" href="{{site_url}}{{canonical_path}}">
  {{#each other_langs}}
  <link rel="alternate" hreflang="{{code}}" href="{{../site_url}}{{canonical_path}}">
  {{/each}}

  <!-- Open Graph -->
  <meta property="og:title" content="{{portfolio_estudio.title}}">
  <meta property="og:description" content="{{portfolio_estudio.meta_description}}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{site_url}}{{canonical_path}}">
  <meta property="og:image" content="{{site_url}}images/tejo_logo_black.png">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{portfolio_estudio.title}}">
  <meta name="twitter:description" content="{{portfolio_estudio.meta_description}}">
  <meta name="twitter:image" content="{{site_url}}images/tejo_logo_black.png">

  <!-- Estilos Base do Tejo Estúdio -->
  <link rel="stylesheet" href="{{{base_path}}}css/tejo-base.css">
  <link rel="stylesheet" href="{{{base_path}}}css/tejo-portfolio.css">
  {{> partials/lang_redirect}}
</head>

<body>
  <div class="tejo-lang-switcher-container">
    {{#each other_langs}}
    <a href="{{{link}}}" class="tejo-lang-switcher" aria-label="{{aria}}" onclick="if(window.tejoSetLang){ window.tejoSetLang('{{code}}'); return false; }">
      {{label}}
    </a>
    {{/each}}
  </div>

  <!-- Barra de Navegação Superior Semântica -->
  <nav class="nav-fixed">
    <div class="nav-inner">
      <div class="tejo-brand-logo">
        <a href="#home">TEJO.</a>
      </div>
      <div class="portfolio-nav-links">
        <a href="{{{language_path}}}index.html">{{portfolio.nav_home}}</a>
        <a href="#missao">{{portfolio_estudio.nav_poetics}}</a>
        <a href="#projetos">{{portfolio.nav_projects}}</a>
        <a href="#circulacao">{{portfolio.nav_circulation}}</a>
        <a href="#chancelas">{{portfolio_estudio.nav_festivals}}</a>
        <a href="#equipe">{{portfolio_estudio.nav_team}}</a>
        <a href="#institucional">{{portfolio_estudio.nav_institutional}}</a>
        <a href="#contato">{{portfolio.nav_contact}}</a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <header id="home" class="portfolio-shell portfolio-hero">
    <h1>TEJO<br>ESTÚDIO</h1>
    <div class="portfolio-hero-divider"></div>
    <p class="portfolio-hero-role">
      {{portfolio_estudio.hero_role}}
    </p>
    <p class="portfolio-hero-location">
      {{portfolio_estudio.hero_location}}
    </p>

    <div class="portfolio-hero-actions">
      <a href="#projetos" class="tejo-btn primary">{{portfolio_estudio.hero_view_projects}} &rarr;</a>
      <a href="{{{base_path}}}docs/portfolio_tejo_estudio.pdf" target="_blank" rel="noopener" class="tejo-btn">
        <img src="{{{base_path}}}images/icons/download.svg" alt="" class="tejo-btn-icon">
        {{{index.download_pdf}}}
      </a>
      <a href="https://store.steampowered.com/app/4605020/Vem_Exu/" target="_blank" rel="noopener" class="tejo-btn">Steam &nearrow;</a>
      <a href="https://kaelfeitosa.itch.io" target="_blank" rel="noopener" class="tejo-btn">Itch.io &nearrow;</a>
    </div>
  </header>

  <!-- Main Content Wrapper -->
  <main>
    
    <!-- Missão e Poética Institucional -->
    <section id="missao" class="portfolio-dark-section portfolio-section">
      <div class="portfolio-shell portfolio-poetics-container">
        <h2 class="portfolio-poetics-title">
          {{portfolio_estudio.poetics_title}}
        </h2>
        <blockquote class="portfolio-poetics-quote">
          {{portfolio_estudio.poetics_quote}}
        </blockquote>
        <div class="portfolio-poetics-grid">
          <p>
            {{{portfolio_estudio.poetics_p1}}}
          </p>
          <p>
            {{{portfolio_estudio.poetics_p2}}}
          </p>
        </div>
      </div>
    </section>

    <!-- Obras e Projetos Principais -->
    <section id="projetos" class="portfolio-shell portfolio-section">
      <header class="portfolio-projects-header">
        <h2>{{portfolio.projects_title}}</h2>
        <span class="portfolio-projects-subtitle">{{portfolio_estudio.projects_intro}}</span>
      </header>

      <div class="portfolio-projects-list">
        <!-- Vem Exu -->
        <article class="project-article">
          <div class="portfolio-col-span-5">
            <figure class="aspect-3-4">
              <img src="{{{base_path}}}images/portfolio/vem_exu.png" alt="{{portfolio.vem_exu_title}}" class="object-cover tejo-grayscale">
            </figure>
          </div>
          <div class="portfolio-col-span-7 project-details-column">
            <h3>{{portfolio.vem_exu_title}}</h3>
            <div class="project-tags">
              <span class="project-tag">{{portfolio.vem_exu_tag1}}</span>
              <span class="project-tag">{{portfolio.vem_exu_tag2}}</span>
              <span class="project-tag">Godot 4 • Steam</span>
            </div>
            <p>
              {{{portfolio.vem_exu_desc}}}
            </p>
            
            <ul class="project-bullets">
              <li>{{{portfolio.vem_exu_poetics}}}</li>
              <li>{{{portfolio.vem_exu_tech}}}</li>
              <li>{{{portfolio.vem_exu_team}}} {{{portfolio.vem_exu_team_desc}}}</li>
              <li>{{{portfolio.vem_exu_highlight}}}</li>
            </ul>

            <!-- Prova Social (Aspas do Press Kit) -->
            <blockquote class="project-quote">
              {{{presskit.quote_1}}}
              <cite>{{{presskit.quote_1_cite}}}</cite>
            </blockquote>

            <div class="project-action-btn">
              <a href="https://store.steampowered.com/app/4605020/Vem_Exu/" target="_blank" rel="noopener" class="tejo-btn primary">{{portfolio.vem_exu_play_demo}} &nearrow;</a>
            </div>
          </div>
        </article>

        <!-- RAIAR -->
        <article class="project-article">
          <div class="portfolio-col-span-7 portfolio-order-2">
             <figure class="aspect-video portfolio-placeholder-frame">
                <span class="portfolio-placeholder-label">{{portfolio.raiar_image_soon}}</span>
             </figure>
          </div>
          <div class="portfolio-col-span-5 portfolio-order-1 project-details-column">
            <h3>{{portfolio.raiar_title}}</h3>
            <div class="project-tags">
              <span class="project-tag">{{portfolio.raiar_tag1}}</span>
              <span class="project-tag">{{portfolio.raiar_tag2}}</span>
              <span class="project-tag">Extensão Universitária ECDD/Infnet</span>
            </div>
            <p>
              {{{portfolio.raiar_desc}}}
            </p>
            <ul class="project-bullets">
              <li>{{{portfolio.raiar_poetics}}}</li>
              <li>{{{portfolio.raiar_tech}}}</li>
              <li>{{{portfolio.raiar_highlight}}}</li>
            </ul>
          </div>
        </article>
      </div>

      <!-- Outras Obras do Estúdio -->
      <div class="portfolio-other-works">
        <h4>{{portfolio.other_works_title}}</h4>
        <div class="portfolio-other-grid">
          <article>
            <a href="https://youtu.be/F-0FELizya8" target="_blank" rel="noopener">
              <figure>
                <img src="{{{base_path}}}images/portfolio/maria_da_lua.png" alt="{{portfolio.maria_lua_title}}" class="object-cover tejo-grayscale">
              </figure>
            </a>
            <h5>{{portfolio.maria_lua_title}}</h5>
            <p>{{{portfolio.maria_lua_desc}}}</p>
            <p class="portfolio-work-team">{{{portfolio.maria_lua_team}}}</p>
            <a href="https://youtu.be/F-0FELizya8" target="_blank" rel="noopener" class="portfolio-work-link">YouTube &nearrow;</a>
          </article>
          <article>
            <a href="https://play.google.com/store/apps/details?id=dev.tiugames.hamilton" target="_blank" rel="noopener">
              <figure>
                <img src="{{{base_path}}}images/portfolio/hamilton.png" alt="{{portfolio.hamilton_title}}" class="object-cover tejo-grayscale">
              </figure>
            </a>
            <h5>{{portfolio.hamilton_title}}</h5>
            <p>{{{portfolio.hamilton_desc}}}</p>
            <p class="portfolio-work-team">{{{portfolio.hamilton_team}}}</p>
            <a href="https://play.google.com/store/apps/details?id=dev.tiugames.hamilton" target="_blank" rel="noopener" class="portfolio-work-link">Google Play &nearrow;</a>
          </article>
          <article>
            <a href="https://kaelfeitosa.itch.io/the-sias-oath" target="_blank" rel="noopener">
              <figure>
                <img src="{{{base_path}}}images/portfolio/sina_de_sia.png" alt="{{portfolio.sina_sia_title}}" class="object-cover tejo-grayscale">
              </figure>
            </a>
            <h5>{{portfolio.sina_sia_title}}</h5>
            <p>{{{portfolio.sina_sia_desc}}}</p>
            <p class="portfolio-work-team">{{{portfolio.sina_sia_team}}}</p>
            <a href="https://kaelfeitosa.itch.io/the-sias-oath" target="_blank" rel="noopener" class="portfolio-work-link">Itch.io &nearrow;</a>
          </article>
        </div>
      </div>
    </section>

    <!-- Exposições, Circulação e Ações Socioculturais (Fotos Reais) -->
    <section id="circulacao" class="portfolio-dark-section portfolio-section">
      <div class="portfolio-shell">
        <h3 class="portfolio-circulation-title">
          ✦ {{portfolio.circulation_title}}
        </h3>
        <p class="portfolio-circulation-desc">
          {{portfolio_estudio.circulation_intro}}
        </p>
        
        <div class="portfolio-circulation-grid">
          <!-- SANA 2026.1 -->
          <article class="portfolio-event-card">
            <div>
              <header class="portfolio-event-header">
                <span class="portfolio-event-tag">{{portfolio.event_sana_tag}}</span>
                <strong class="portfolio-event-title">{{portfolio.event_sana_title}}</strong>
              </header>
              <p class="portfolio-event-desc">
                {{portfolio.event_sana_desc}}
              </p>
            </div>
            <div class="portfolio-event-gallery">
              <figure class="portfolio-gallery-item">
                <a href="{{{base_path}}}press-kit/vem-exu/03_community/events/sana_2026_1_01.jpeg" target="_blank" rel="noopener" aria-label="{{{presskit.alt_event_sana_01}}}">
                  <img src="{{{base_path}}}press-kit/vem-exu/03_community/events/sana_2026_1_01.jpeg" alt="{{{presskit.alt_event_sana_01}}}" class="tejo-grayscale">
                </a>
              </figure>
              <figure class="portfolio-gallery-item">
                <a href="{{{base_path}}}press-kit/vem-exu/03_community/events/sana_2026_1_02.jpeg" target="_blank" rel="noopener" aria-label="{{{presskit.alt_event_sana_02}}}">
                  <img src="{{{base_path}}}press-kit/vem-exu/03_community/events/sana_2026_1_02.jpeg" alt="{{{presskit.alt_event_sana_02}}}" class="tejo-grayscale">
                </a>
              </figure>
              <figure class="portfolio-gallery-item">
                <a href="{{{base_path}}}press-kit/vem-exu/03_community/events/sana_2026_1_03.jpeg" target="_blank" rel="noopener" aria-label="{{{presskit.alt_event_sana_03}}}">
                  <img src="{{{base_path}}}press-kit/vem-exu/03_community/events/sana_2026_1_03.jpeg" alt="{{{presskit.alt_event_sana_03}}}" class="tejo-grayscale">
                </a>
              </figure>
            </div>
          </article>

          <!-- Feira do Conhecimento 2025 -->
          <article class="portfolio-event-card">
            <div>
              <header class="portfolio-event-header">
                <span class="portfolio-event-tag">{{portfolio.event_feira_tag}}</span>
                <strong class="portfolio-event-title">{{portfolio.event_feira_title}}</strong>
              </header>
              <p class="portfolio-event-desc">
                {{portfolio.event_feira_desc}}
              </p>
            </div>
            <div class="portfolio-event-gallery">
              <figure class="portfolio-gallery-item">
                <a href="{{{base_path}}}press-kit/vem-exu/03_community/events/feira_do_conhecimento_01.jpeg" target="_blank" rel="noopener" aria-label="{{{presskit.alt_event_feira_01}}}">
                  <img src="{{{base_path}}}press-kit/vem-exu/03_community/events/feira_do_conhecimento_01.jpeg" alt="{{{presskit.alt_event_feira_01}}}" class="tejo-grayscale">
                </a>
              </figure>
              <figure class="portfolio-gallery-item">
                <a href="{{{base_path}}}press-kit/vem-exu/03_community/events/feira_do_conhecimento_02.jpeg" target="_blank" rel="noopener" aria-label="{{{presskit.alt_event_feira_02}}}">
                  <img src="{{{base_path}}}press-kit/vem-exu/03_community/events/feira_do_conhecimento_02.jpeg" alt="{{{presskit.alt_event_feira_02}}}" class="tejo-grayscale">
                </a>
              </figure>
              <figure class="portfolio-gallery-item">
                <a href="{{{base_path}}}press-kit/vem-exu/03_community/events/feira_do_conhecimento_03.jpeg" target="_blank" rel="noopener" aria-label="{{{presskit.alt_event_feira_03}}}">
                  <img src="{{{base_path}}}press-kit/vem-exu/03_community/events/feira_do_conhecimento_03.jpeg" alt="{{{presskit.alt_event_feira_03}}}" class="tejo-grayscale">
                </a>
              </figure>
            </div>
          </article>

          <!-- Escolas Públicas e Equipamentos Culturais -->
          <article class="portfolio-event-card">
            <div>
              <header class="portfolio-event-header">
                <span class="portfolio-event-tag">{{portfolio.event_escolas_tag}}</span>
                <strong class="portfolio-event-title">{{portfolio.event_escolas_title}}</strong>
              </header>
              <p class="portfolio-event-desc">
                {{portfolio.event_escolas_desc}}
              </p>
            </div>
            <div class="portfolio-event-gallery">
              <figure class="portfolio-gallery-item">
                <a href="{{{base_path}}}press-kit/vem-exu/03_community/events/escola_torres_de_melo_01.jpg" target="_blank" rel="noopener" aria-label="{{{presskit.alt_event_escola_01}}}">
                  <img src="{{{base_path}}}press-kit/vem-exu/03_community/events/escola_torres_de_melo_01.jpg" alt="{{{presskit.alt_event_escola_01}}}" class="tejo-grayscale">
                </a>
              </figure>
              <figure class="portfolio-gallery-item">
                <a href="{{{base_path}}}press-kit/vem-exu/03_community/events/nac_passare_01.jpg" target="_blank" rel="noopener" aria-label="{{{presskit.alt_event_nac_01}}}">
                  <img src="{{{base_path}}}press-kit/vem-exu/03_community/events/nac_passare_01.jpg" alt="{{{presskit.alt_event_nac_01}}}" class="tejo-grayscale">
                </a>
              </figure>
              <figure class="portfolio-gallery-item">
                <a href="{{{base_path}}}press-kit/vem-exu/03_community/events/nac_passare_02.jpg" target="_blank" rel="noopener" aria-label="{{{presskit.alt_event_nac_02}}}">
                  <img src="{{{base_path}}}press-kit/vem-exu/03_community/events/nac_passare_02.jpg" alt="{{{presskit.alt_event_nac_02}}}" class="tejo-grayscale">
                </a>
              </figure>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Chancelas e Festivais Oficiais (2026) -->
    <section id="chancelas" class="portfolio-shell portfolio-section">
      <header class="portfolio-projects-header">
        <h2>{{portfolio_estudio.festivals_title}}</h2>
        <span class="portfolio-projects-subtitle">{{portfolio_estudio.festivals_subtitle}}</span>
      </header>

      <div class="studio-grid-2 studio-grid-festivals">
        {{#each portfolio_estudio.festivals}}
        <div class="festival-badge"><span class="check">✔</span> {{this}}</div>
        {{/each}}
      </div>
    </section>

    <!-- Núcleo Criativo e Governança da Equipe -->
    <section id="equipe" class="portfolio-dark-section portfolio-section">
      <div class="portfolio-shell">
        <h2 class="portfolio-team-heading">
          {{portfolio_estudio.team_title}}
        </h2>
        <p class="portfolio-team-subtitle">
          {{portfolio_estudio.team_subtitle}}
        </p>

        <div class="studio-grid-2">
          <!-- Michael Feitosa -->
          <div class="studio-card">
            <h4>Michael Feitosa</h4>
            <div class="studio-role-tag">{{portfolio_estudio.team_michael_role}}</div>
            <p>
              {{portfolio_estudio.team_michael_bio}}
            </p>
          </div>

          <!-- Rafael Semino -->
          <div class="studio-card">
            <h4>Rafael Semino</h4>
            <div class="studio-role-tag">{{portfolio_estudio.team_rafael_role}}</div>
            <p>
              {{portfolio_estudio.team_rafael_bio}}
            </p>
          </div>

          <!-- Valdir Marte -->
          <div class="studio-card">
            <h4>Valdir Marte</h4>
            <div class="studio-role-tag">{{portfolio_estudio.team_valdir_role}}</div>
            <p>
              {{portfolio_estudio.team_valdir_bio}}
            </p>
          </div>

          <!-- Zeis -->
          <div class="studio-card">
            <h4>Zeis</h4>
            <div class="studio-role-tag">{{portfolio_estudio.team_zeis_role}}</div>
            <p>
              {{portfolio_estudio.team_zeis_bio}}
            </p>
          </div>

          <!-- Douglas -->
          <div class="studio-card">
            <h4>Douglas</h4>
            <div class="studio-role-tag">{{portfolio_estudio.team_douglas_role}}</div>
            <p>
              {{portfolio_estudio.team_douglas_bio}}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Dados Cadastrais e Regularidade Institucional (Página 06 do Edital) -->
    <section id="institucional" class="portfolio-about portfolio-section">
      <div class="portfolio-shell">
        <article class="portfolio-about-card">
          <h2>{{portfolio_estudio.about_title}}</h2>
          
          <div class="portfolio-about-content">
            <!-- Logo Tejo Estúdio -->
            <figure class="portfolio-about-avatar studio-avatar">
              <img src="{{{base_path}}}images/tejo_logo_black.png" alt="Tejo Estúdio">
            </figure>
            
            <!-- Texto Cadastral -->
            <div class="portfolio-about-text">
              <p>{{{portfolio_estudio.about_p1}}}</p>
              <p>{{{portfolio_estudio.about_p2}}}</p>
            </div>
          </div>

          <!-- Contatos e Dossiê -->
          <footer class="portfolio-about-footer">
            <address id="contato" class="portfolio-contact-block">
              <h3>{{portfolio.nav_contact}}</h3>
              <a href="mailto:contato@tejoestudio.com.br">
                ✉ contato@tejoestudio.com.br
              </a>
              <br>
              <a href="mailto:michaelrfeitosa@gmail.com" class="portfolio-contact-sublink">
                {{portfolio_estudio.contact_direction}}: michaelrfeitosa@gmail.com
              </a>
            </address>

            <div class="portfolio-docs-block">
              <h3>{{portfolio_estudio.docs_title}}</h3>
              <a href="{{{base_path}}}docs/portfolio_tejo_estudio.pdf" target="_blank" rel="noopener" class="portfolio-download-btn">
                {{portfolio_estudio.pdf_studio}}
              </a>
              <a href="{{{base_path}}}docs/portfolio_michael_feitosa.pdf" target="_blank" rel="noopener" class="portfolio-download-btn btn-founder">
                {{portfolio_estudio.pdf_founder}}
              </a>
            </div>
          </footer>
        </article>
      </div>
    </section>

  </main>

  <footer class="tejo-footer">
    <img src="{{{base_path}}}images/tejo_logo_black.png" alt="Tejo Estúdio" class="tejo-footer-logo">
    <div class="tejo-footer-content">
      <p>
        {{index.footer}}<br>
        <span class="tejo-footer-meta">{{{index.footer_meta}}}</span>
        | <a href="{{{language_path}}}index.html">{{portfolio.nav_home}}</a>
        | <a href="{{{language_path}}}privacy.html">{{{index.privacy}}}</a>
      </p>
      {{> partials/footer_social}}
    </div>
  </footer>
</body>

</html>
